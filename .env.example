# Kopiere diese Datei nach ".env" und trage deine eigenen Werte ein.
# Die echte .env gehoert NIE in Git (steht in der .gitignore).

# OpenAI (wird vom OpenAI-Client automatisch gelesen)
OPENAI_API_KEY=

# Neon / PostgreSQL, z.B. postgresql://user:passwort@host/dbname?sslmode=require
DATABASE_URL=

# Brave Search API (fuer die Websuche)
BRAVE_API_KEY=

# Optional: anderes Sprachmodell als der Standard
# JARVIS_MODEL=gpt-5.6-luna
